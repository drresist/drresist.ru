#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-build}"
case "$COMMAND" in
  build|serve|check) ;;
  *) echo "Usage: scripts/site [build|serve|check]" >&2; exit 2 ;;
esac

cd "$ROOT"
cargo run --quiet --manifest-path tools/postcheck/Cargo.toml -- posts
rm -rf content/posts
mkdir -p content/posts
shopt -s nullglob
for post in posts/*.md; do
  cp "$post" content/posts/
done
exec zola "$COMMAND"
